#!/usr/bin/env bash
# ha-api — call the Home Assistant REST API without ever showing the token.
# Usage: ha-api [GET|POST|DELETE] /api/path ['{"json": "body"}']
#   ha-api /api/                       -> {"message":"API running."}
#   ha-api GET /api/states/sun.sun
#   ha-api POST /api/services/light/turn_on '{"entity_id":"light.kitchen"}'
# The URL comes from the add-on option "ha_url", the token from the "ha_token" option.
set -euo pipefail
METHOD=GET
case "${1:-}" in GET|POST|DELETE) METHOD="$1"; shift ;; esac
P="${1:?usage: ha-api [GET|POST|DELETE] /api/path [json]}"
case "$P" in /*) ;; *) echo "ha-api: path must start with /" >&2; exit 2 ;; esac
URL="$(jq -r '.ha_url // empty' /data/options.json)"
URL="${URL:-http://homeassistant:8123}"
TOKEN="$(jq -r '.ha_token // empty' /data/options.json)"
args=(-sS --fail-with-body -X "$METHOD" -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json")
if [ $# -ge 2 ]; then args+=(--data "$2"); fi
exec curl "${args[@]}" "${URL%/}${P}"
